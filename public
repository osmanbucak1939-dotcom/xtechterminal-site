<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TradeX — White-Label Trading Terminal</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #0A0E14;
    --bg-alt: #0D1219;
    --surface: #121924;
    --surface-2: #171F2C;
    --border: #232C3B;
    --text: #E9ECF2;
    --text-dim: #8B94A6;
    --text-faint: #5B6478;
    --gold: #D4A64C;
    --gold-soft: #E8C87D;
    --bull: #3FA372;
    --bear: #C4534A;
    --font-display: 'Space Grotesk', sans-serif;
    --font-body: 'IBM Plex Sans', sans-serif;
    --font-mono: 'IBM Plex Mono', monospace;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--bg);
    color:var(--text);
    font-family:var(--font-body);
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  a{color:inherit;text-decoration:none;}
  img{max-width:100%;display:block;}
  .wrap{max-width:1180px;margin:0 auto;padding:0 32px;}
  @media(max-width:720px){.wrap{padding:0 20px;}}

  a:focus-visible, button:focus-visible{outline:2px solid var(--gold);outline-offset:3px;}

  .ticker-band{
    background:var(--bg-alt);
    border-bottom:1px solid var(--border);
    overflow:hidden;
    white-space:nowrap;
    padding:9px 0;
    position:relative;
    z-index:40;
  }
  .ticker-track{
    display:inline-flex;
    animation:scroll-left 42s linear infinite;
  }
  @media(prefers-reduced-motion: reduce){.ticker-track{animation:none;}}
  .ticker-item{
    font-family:var(--font-mono);
    font-size:12.5px;
    color:var(--text-dim);
    padding:0 22px;
    display:inline-flex;
    align-items:center;
    gap:8px;
    border-right:1px solid var(--border);
  }
  .ticker-item b{color:var(--text);font-weight:500;}
  .ticker-item .up{color:var(--bull);}
  .ticker-item .down{color:var(--bear);}
  @keyframes scroll-left{
    0%{transform:translateX(0);}
    100%{transform:translateX(-50%);}
  }

  header{
    position:sticky;top:0;
    background:rgba(10,14,20,0.88);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--border);
    z-index:50;
  }
  .nav{display:flex;align-items:center;justify-content:space-between;padding:16px 32px;max-width:1180px;margin:0 auto;}
  .logo{font-family:var(--font-display);font-weight:700;font-size:21px;letter-spacing:0.3px;display:flex;align-items:center;gap:9px;}
  .logo .dot{width:8px;height:8px;border-radius:1px;background:var(--gold);display:inline-block;transform:rotate(45deg);}
  .nav-links{display:flex;gap:34px;font-size:14.5px;color:var(--text-dim);}
  .nav-links a:hover{color:var(--text);}
  .nav-cta{display:flex;gap:12px;align-items:center;}
  .btn{
    font-family:var(--font-body);
    font-weight:600;
    font-size:14px;
    padding:10px 20px;
    border-radius:3px;
    border:1px solid transparent;
    cursor:pointer;
    display:inline-flex;align-items:center;gap:8px;
    transition:all .15s ease;
  }
  .btn-gold{background:var(--gold);color:#12100A;}
  .btn-gold:hover{background:var(--gold-soft);}
  .btn-ghost{border-color:var(--border);color:var(--text);background:transparent;}
  .btn-ghost:hover{border-color:var(--text-faint);}
  .lang-switch{display:flex;border:1px solid var(--border);border-radius:4px;overflow:hidden;}
  .lang-btn{
    font-family:var(--font-mono);font-size:12px;font-weight:600;
    padding:8px 11px;background:transparent;color:var(--text-faint);
    cursor:pointer;border:none;transition:all .15s;
  }
  .lang-btn.active{background:var(--gold);color:#12100A;}
  .lang-btn:not(.active):hover{color:var(--text);}
  @media(max-width:900px){
    .nav-links{display:none;}
    .nav-cta .btn-ghost{display:none;}
  }

  .hero{
    padding:88px 0 100px;
    position:relative;
    background:
      radial-gradient(ellipse 900px 500px at 82% 8%, rgba(212,166,76,0.10), transparent 60%),
      radial-gradient(ellipse 700px 400px at -5% 90%, rgba(63,163,114,0.06), transparent 60%);
  }
  .hero-grid{display:grid;grid-template-columns:1.05fr 0.95fr;gap:56px;align-items:center;}
  @media(max-width:920px){.hero-grid{grid-template-columns:1fr;}}
  .eyebrow{
    font-family:var(--font-mono);
    font-size:12.5px;
    color:var(--gold-soft);
    letter-spacing:1.5px;
    text-transform:uppercase;
    display:flex;align-items:center;gap:10px;
    margin-bottom:22px;
  }
  .eyebrow::before{content:'';width:22px;height:1px;background:var(--gold);display:inline-block;}
  h1{
    font-family:var(--font-display);
    font-size:clamp(34px, 4.4vw, 54px);
    line-height:1.06;
    font-weight:700;
    letter-spacing:-0.5px;
    margin-bottom:22px;
  }
  h1 em{font-style:normal;color:var(--gold-soft);}
  .hero-sub{
    font-size:17px;
    color:var(--text-dim);
    max-width:520px;
    margin-bottom:34px;
    line-height:1.65;
  }
  .hero-cta{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:40px;}
  .btn-lg{padding:14px 26px;font-size:15px;}
  .hero-meta{display:flex;gap:32px;flex-wrap:wrap;}
  .hero-meta-item{font-size:13px;color:var(--text-faint);}
  .hero-meta-item b{display:block;font-family:var(--font-mono);font-size:19px;color:var(--text);font-weight:500;margin-bottom:2px;}

  .chart-card{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:8px;
    padding:20px 20px 0;
    box-shadow:0 30px 60px -20px rgba(0,0,0,0.5);
  }
  .chart-head{display:flex;justify-content:space-between;align-items:flex-start;padding-bottom:16px;border-bottom:1px solid var(--border);margin-bottom:16px;}
  .chart-symbol{font-family:var(--font-mono);font-size:14px;font-weight:600;}
  .chart-symbol span{color:var(--text-faint);font-weight:400;margin-left:8px;}
  .chart-price{font-family:var(--font-mono);font-size:22px;font-weight:600;color:var(--bull);}
  .chart-price small{display:block;font-size:11px;color:var(--text-faint);font-weight:400;font-family:var(--font-body);text-align:right;}
  .candles{display:flex;align-items:flex-end;gap:4px;height:180px;padding-bottom:14px;}
  .candle{flex:1;position:relative;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;}
  .wick{width:1px;background:var(--text-faint);opacity:0.5;}
  .body-c{width:100%;border-radius:1px;}
  .body-c.up{background:var(--bull);}
  .body-c.down{background:var(--bear);}
  .chart-footer{display:flex;justify-content:space-between;padding:12px 0;border-top:1px solid var(--border);font-family:var(--font-mono);font-size:11px;color:var(--text-faint);}
  .live-dot{width:6px;height:6px;border-radius:50%;background:var(--bull);display:inline-block;margin-right:6px;animation:pulse 1.8s ease-in-out infinite;}
  @keyframes pulse{0%,100%{opacity:1;}50%{opacity:0.35;}}
  @media(prefers-reduced-motion: reduce){.live-dot{animation:none;}}

  section{padding:96px 0;}
  .section-head{max-width:640px;margin-bottom:56px;}
  .section-head.center{margin-left:auto;margin-right:auto;text-align:center;}
  .section-eyebrow{font-family:var(--font-mono);font-size:12px;color:var(--gold-soft);letter-spacing:1.5px;text-transform:uppercase;margin-bottom:14px;}
  h2{font-family:var(--font-display);font-size:clamp(26px,3vw,36px);font-weight:600;letter-spacing:-0.3px;margin-bottom:14px;}
  .section-sub{color:var(--text-dim);font-size:15.5px;line-height:1.7;}

  .audience{background:var(--bg-alt);border-top:1px solid var(--border);border-bottom:1px solid var(--border);}
  .audience-grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--border);border:1px solid var(--border);border-radius:8px;overflow:hidden;}
  @media(max-width:720px){.audience-grid{grid-template-columns:1fr;}}
  .audience-card{background:var(--bg-alt);padding:36px;transition:background .2s;}
  .audience-card:hover{background:var(--surface);}
  .audience-num{font-family:var(--font-mono);color:var(--text-faint);font-size:12px;margin-bottom:16px;}
  .audience-card h3{font-family:var(--font-display);font-size:21px;margin-bottom:10px;}
  .audience-card p{color:var(--text-dim);font-size:14.5px;margin-bottom:20px;line-height:1.6;}
  .audience-card a{font-size:13.5px;font-weight:600;color:var(--gold-soft);display:inline-flex;align-items:center;gap:6px;}

  .feat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border);border:1px solid var(--border);border-radius:8px;overflow:hidden;}
  @media(max-width:860px){.feat-grid{grid-template-columns:repeat(2,1fr);}}
  @media(max-width:560px){.feat-grid{grid-template-columns:1fr;}}
  .feat{background:var(--bg);padding:30px 26px;}
  .feat-icon{width:34px;height:34px;border:1px solid var(--border);border-radius:6px;display:flex;align-items:center;justify-content:center;margin-bottom:18px;color:var(--gold-soft);}
  .feat h4{font-family:var(--font-display);font-size:16.5px;margin-bottom:9px;font-weight:600;}
  .feat p{color:var(--text-dim);font-size:14px;line-height:1.6;}

  .shots{background:var(--bg-alt);border-top:1px solid var(--border);border-bottom:1px solid var(--border);}
  .shots-tabs{display:flex;gap:10px;margin-bottom:40px;}
  .shots-tab{
    font-family:var(--font-mono);font-size:12.5px;letter-spacing:0.4px;
    padding:9px 18px;border:1px solid var(--border);border-radius:20px;
    color:var(--text-dim);cursor:pointer;background:transparent;transition:all .15s;
  }
  .shots-tab.active{border-color:var(--gold);color:var(--gold-soft);background:rgba(212,166,76,0.08);}
  .shots-panel{display:none;}
  .shots-panel.active{display:block;}

  .browser-frame{
    background:#15191F;
    border:1px solid var(--border);
    border-radius:10px;
    overflow:hidden;
    box-shadow:0 40px 80px -30px rgba(0,0,0,0.6);
  }
  .browser-bar{display:flex;align-items:center;gap:8px;padding:11px 14px;background:#1B2028;border-bottom:1px solid var(--border);}
  .browser-dot{width:9px;height:9px;border-radius:50%;background:#3A4150;}
  .browser-url{
    margin-left:14px;flex-grow:1;background:#12151B;border-radius:5px;
    padding:5px 12px;font-family:var(--font-mono);font-size:11.5px;color:var(--text-faint);
  }
  .browser-frame img{width:100%;display:block;}

  .desktop-pair{display:grid;grid-template-columns:1fr;gap:28px;}
  .desktop-caption{display:flex;justify-content:space-between;align-items:center;margin-top:14px;}
  .desktop-caption span{font-size:13px;color:var(--text-dim);}
  .desktop-caption .tag{font-family:var(--font-mono);font-size:11px;color:var(--gold-soft);border:1px solid var(--border);padding:3px 9px;border-radius:12px;}

  .phone-row{display:flex;gap:40px;justify-content:center;flex-wrap:wrap;}
  .phone-frame{
    width:230px;
    border:8px solid #1B2028;
    border-radius:34px;
    background:#1B2028;
    box-shadow:0 30px 70px -25px rgba(0,0,0,0.6);
    position:relative;
  }
  .phone-notch{
    position:absolute;top:0;left:50%;transform:translateX(-50%);
    width:70px;height:18px;background:#1B2028;border-radius:0 0 10px 10px;z-index:2;
  }
  .phone-screen{border-radius:26px;overflow:hidden;}
  .phone-screen img{width:100%;display:block;}
  .phone-caption{text-align:center;margin-top:16px;font-size:13px;color:var(--text-dim);}
  .phone-caption .tag{display:block;font-family:var(--font-mono);font-size:11px;color:var(--gold-soft);margin-top:4px;}

  /* ---------- Liquidity ---------- */
  .liq-grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center;}
  @media(max-width:900px){.liq-grid{grid-template-columns:1fr;}}
  .liq-pillars{display:flex;flex-direction:column;gap:22px;}
  .liq-pillar{display:flex;gap:16px;}
  .liq-pillar-num{font-family:var(--font-mono);font-size:12px;color:var(--gold-soft);width:26px;flex-shrink:0;padding-top:3px;}
  .liq-pillar h4{font-size:15.5px;font-weight:600;margin-bottom:6px;}
  .liq-pillar p{font-size:13.5px;color:var(--text-dim);line-height:1.6;}

  .liq-diagram{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:10px;
    padding:30px 26px;
  }
  .liq-row{display:flex;align-items:center;gap:14px;margin-bottom:0;}
  .liq-node{
    flex:1;background:var(--bg);border:1px solid var(--border);border-radius:7px;
    padding:14px 16px;text-align:center;
  }
  .liq-node .lbl{font-family:var(--font-mono);font-size:10.5px;color:var(--text-faint);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px;}
  .liq-node .val{font-size:13px;font-weight:600;}
  .liq-node.center{border-color:var(--gold);background:rgba(212,166,76,0.06);}
  .liq-node.center .val{color:var(--gold-soft);}
  .liq-arrow{color:var(--text-faint);font-family:var(--font-mono);font-size:16px;flex-shrink:0;}
  .liq-sources{display:flex;flex-direction:column;gap:10px;}
  .liq-clients{display:flex;flex-direction:column;gap:10px;}
  .liq-flow{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;align-items:center;gap:10px;}
  @media(max-width:520px){.liq-flow{grid-template-columns:1fr;}
    .liq-flow .liq-arrow{transform:rotate(90deg);justify-self:center;}}
  .liq-node.small{padding:10px 12px;}
  .liq-node.small .val{font-size:11.5px;}
  .liq-caption{margin-top:20px;padding-top:18px;border-top:1px solid var(--border);font-size:12px;color:var(--text-faint);text-align:center;}

  /* ---------- CRM ---------- */
  .crm-badge-wrap{display:flex;align-items:center;gap:10px;margin-bottom:14px;}
  .illustrative-badge{
    font-family:var(--font-mono);font-size:11px;color:var(--text-faint);
    border:1px dashed var(--border);padding:4px 10px;border-radius:12px;letter-spacing:0.3px;
  }
  .crm-grid{display:grid;grid-template-columns:1fr 1.2fr;gap:48px;align-items:start;}
  @media(max-width:900px){.crm-grid{grid-template-columns:1fr;}}
  .crm-features{display:flex;flex-direction:column;gap:20px;}
  .crm-feature{display:flex;gap:14px;}
  .crm-feature .dot2{width:6px;height:6px;background:var(--gold);border-radius:50%;flex-shrink:0;margin-top:7px;}
  .crm-feature h4{font-size:14.5px;font-weight:600;margin-bottom:4px;}
  .crm-feature p{font-size:13px;color:var(--text-dim);line-height:1.6;}

  .crm-mock{
    background:#15191F;border:1px solid var(--border);border-radius:10px;overflow:hidden;
    box-shadow:0 40px 80px -30px rgba(0,0,0,0.6);
    display:grid;grid-template-columns:150px 1fr;min-height:340px;
  }
  .crm-sidebar{background:#12151B;border-right:1px solid var(--border);padding:18px 0;}
  .crm-sidebar .crm-logo{font-family:var(--font-display);font-weight:700;font-size:13px;padding:0 16px 16px;color:var(--text-dim);}
  .crm-nav-item{padding:9px 16px;font-size:12px;color:var(--text-faint);display:flex;align-items:center;gap:8px;}
  .crm-nav-item.active{color:var(--gold-soft);background:rgba(212,166,76,0.08);border-right:2px solid var(--gold);}
  .crm-main{padding:20px 22px;}
  .crm-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:18px;}
  .crm-kpi{background:var(--bg);border:1px solid var(--border);border-radius:6px;padding:11px 12px;}
  .crm-kpi .k-lbl{font-size:9.5px;color:var(--text-faint);text-transform:uppercase;letter-spacing:0.3px;margin-bottom:5px;}
  .crm-kpi .k-val{font-family:var(--font-mono);font-size:15px;font-weight:600;}
  .crm-table{background:var(--bg);border:1px solid var(--border);border-radius:6px;overflow:hidden;}
  .crm-t-head, .crm-t-row{display:grid;grid-template-columns:1.4fr 1fr 0.8fr 0.8fr;padding:8px 12px;font-size:11px;}
  .crm-t-head{color:var(--text-faint);text-transform:uppercase;font-size:9.5px;letter-spacing:0.3px;border-bottom:1px solid var(--border);}
  .crm-t-row{border-bottom:1px solid var(--border);color:var(--text-dim);}
  .crm-t-row:last-child{border-bottom:none;}
  .crm-t-row .status{padding:2px 7px;border-radius:8px;font-size:9.5px;width:fit-content;}
  .status.ok{background:rgba(63,163,114,0.15);color:var(--bull);}
  .status.pending{background:rgba(212,166,76,0.15);color:var(--gold-soft);}

  .arch{background:var(--bg-alt);border-top:1px solid var(--border);border-bottom:1px solid var(--border);}
  .arch-grid{display:grid;grid-template-columns:0.85fr 1.15fr;gap:60px;align-items:start;}
  @media(max-width:900px){.arch-grid{grid-template-columns:1fr;}}
  .arch-list{display:flex;flex-direction:column;}
  .arch-row{display:flex;gap:18px;padding:20px 0;border-bottom:1px solid var(--border);}
  .arch-row:last-child{border-bottom:none;}
  .arch-tag{font-family:var(--font-mono);font-size:11px;color:var(--gold-soft);width:96px;flex-shrink:0;padding-top:2px;}
  .arch-row h4{font-size:15.5px;font-weight:600;margin-bottom:6px;}
  .arch-row p{font-size:13.5px;color:var(--text-dim);line-height:1.6;}
  .arch-panel{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:26px;font-family:var(--font-mono);font-size:12.5px;color:var(--text-dim);}
  .arch-panel .line{padding:5px 0;border-bottom:1px dashed var(--border);display:flex;justify-content:space-between;}
  .arch-panel .line:last-child{border-bottom:none;}
  .arch-panel .ok{color:var(--bull);}

  .process{display:grid;grid-template-columns:repeat(4,1fr);gap:28px;}
  @media(max-width:860px){.process{grid-template-columns:repeat(2,1fr);}}
  @media(max-width:520px){.process{grid-template-columns:1fr;}}
  .step{position:relative;padding-top:40px;}
  .step-num{font-family:var(--font-display);font-size:34px;font-weight:700;color:transparent;-webkit-text-stroke:1px var(--border);position:absolute;top:-6px;left:0;}
  .step h4{font-size:16px;font-weight:600;margin-bottom:8px;}
  .step p{font-size:13.5px;color:var(--text-dim);line-height:1.6;}

  .pricing-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;}
  @media(max-width:900px){.pricing-grid{grid-template-columns:1fr;max-width:420px;margin:0 auto;}}
  .plan{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:32px 28px;display:flex;flex-direction:column;}
  .plan.featured{border-color:var(--gold);position:relative;background:var(--surface-2);}
  .plan-badge{position:absolute;top:-12px;left:28px;background:var(--gold);color:#12100A;font-size:11px;font-weight:700;padding:4px 10px;border-radius:3px;letter-spacing:0.3px;}
  .plan h3{font-family:var(--font-display);font-size:19px;margin-bottom:8px;}
  .plan .plan-desc{font-size:13.5px;color:var(--text-dim);margin-bottom:22px;min-height:36px;}
  .plan .plan-price{font-family:var(--font-mono);font-size:15px;color:var(--gold-soft);margin-bottom:22px;padding-bottom:22px;border-bottom:1px solid var(--border);}
  .plan ul{list-style:none;display:flex;flex-direction:column;gap:12px;margin-bottom:28px;flex-grow:1;}
  .plan li{font-size:13.5px;color:var(--text-dim);display:flex;gap:10px;line-height:1.5;}
  .plan li::before{content:'';width:5px;height:5px;background:var(--gold);flex-shrink:0;margin-top:7px;transform:rotate(45deg);}
  .plan .btn{width:100%;justify-content:center;}

  .faq{max-width:800px;}
  .faq-item{border-bottom:1px solid var(--border);}
  .faq-q{padding:22px 0;display:flex;justify-content:space-between;align-items:center;cursor:pointer;font-size:15.5px;font-weight:600;gap:20px;}
  .faq-q .plus{font-family:var(--font-mono);color:var(--gold-soft);font-size:18px;flex-shrink:0;transition:transform .2s;}
  .faq-item.open .faq-q .plus{transform:rotate(45deg);}
  .faq-a{max-height:0;overflow:hidden;transition:max-height .25s ease;}
  .faq-a p{padding-bottom:22px;color:var(--text-dim);font-size:14.5px;line-height:1.7;max-width:680px;}

  .cta-section{background:var(--bg-alt);border-top:1px solid var(--border);}
  .cta-box{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:10px;
    padding:56px;
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:50px;
    position:relative;
    overflow:hidden;
  }
  .cta-box::before{content:'';position:absolute;top:-40%;right:-15%;width:420px;height:420px;background:radial-gradient(circle,rgba(212,166,76,0.10),transparent 70%);}
  @media(max-width:820px){.cta-box{grid-template-columns:1fr;padding:36px 26px;}}
  .cta-form{display:flex;flex-direction:column;gap:14px;position:relative;}
  .cta-form input, .cta-form select, .cta-form textarea{
    background:var(--bg);
    border:1px solid var(--border);
    color:var(--text);
    padding:12px 14px;
    border-radius:5px;
    font-family:var(--font-body);
    font-size:14px;
  }
  .cta-form input::placeholder, .cta-form textarea::placeholder{color:var(--text-faint);}
  .cta-form input:focus, .cta-form select:focus, .cta-form textarea:focus{outline:1px solid var(--gold);border-color:var(--gold);}
  .cta-note{font-size:12px;color:var(--text-faint);margin-top:4px;}

  footer{padding:60px 0 34px;border-top:1px solid var(--border);}
  .foot-grid{display:grid;grid-template-columns:1.4fr repeat(3,1fr);gap:40px;margin-bottom:48px;}
  @media(max-width:760px){.foot-grid{grid-template-columns:1fr 1fr;}}
  .foot-brand p{color:var(--text-dim);font-size:13.5px;line-height:1.65;margin-top:14px;max-width:280px;}
  .foot-col h5{font-size:12.5px;text-transform:uppercase;letter-spacing:0.5px;color:var(--text-faint);margin-bottom:16px;}
  .foot-col a{display:block;font-size:14px;color:var(--text-dim);margin-bottom:11px;}
  .foot-col a:hover{color:var(--text);}
  .foot-bottom{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;padding-top:28px;border-top:1px solid var(--border);font-size:12.5px;color:var(--text-faint);}

  ::selection{background:var(--gold);color:#12100A;}
</style>
